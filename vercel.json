{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,OPTIONS"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://trello.com https://*.trello.com;"
        }
      ]
    }
  ]
}

